#version 460
#include "shaders/atmosphere.glsl"
void main() {
    int index=int(gl_GlobalInvocationID.x);
    if(index>=imageSize(Output0).x) return;
    vec3 result=vec3(0);
    if(atmBlend()>0.0) {
        if(index==0) result=ATM_SOLAR*cinematicKeyScale()*cinematicKeyTint()*atmSunTransmittance(atmObserverHeight(),cinematicKeyDirection().y,64);
        else if(index<10) {
            for(int i=0;i<256;i++) {
                float y=1.0-2.0*(float(i)+0.5)/256.0,phi=float(i)*2.399963230;
                vec3 d=vec3(cos(phi)*sqrt(1.0-y*y),y,sin(phi)*sqrt(1.0-y*y));
                result+=atmSky(Sky,d)*atmBasis(index-1,d);
            }
            float kernel=index==1 ? ATM_PI : index<=4 ? 2.0*ATM_PI/3.0 : ATM_PI/4.0;
            result*=4.0*ATM_PI/256.0*kernel;
        }
#if ATM_MULTIPLE_SCATTERING == 1
        else {
            result=ATM_SOLAR*atmMultiple(AtmosphereMultiple,atmObserverHeight(),normalize(SunDirectionAndRainBrightness.xyz).y);
#if NIGHT_SKY == 1
            result+=ATM_SOLAR*CINEMATIC_MOON_SCALE*cinematicMoonPhase()*CINEMATIC_MOON_TINT*atmMultiple(AtmosphereMultiple,atmObserverHeight(),normalize(MoonDirectionAndPhase.xyz).y);
#endif
        }
#endif
    }
    imageStore(Output0,ivec2(index,0),vec4(result,1));
}
