        vec3(0,0,1),vec3(0,0,-1),vec3(1,1,1),vec3(-1,1,-1));
    const float lengths[8]=float[8](0.0,0.001,0.125,0.5,1.0,2.0,6.0,31.25);
    float length=lengths[p.x%8];vec3 direction=normalize(directions[p.y%8]);
    int count=clamp(int(ceil(length)),1,32);float ds=length/float(count);
    imageStore(Output0,p,cinematicCloudDensityColumn(CloudLayout,origin,direction,length));
    imageStore(Output1,p,vec4(origin,length));imageStore(Output2,p,vec4(direction,float(count)));
