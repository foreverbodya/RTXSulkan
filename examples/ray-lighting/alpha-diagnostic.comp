#version 460
#include "sulkan/ray-terrain.glsl"
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(Output0);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 eye = InverseProjection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 direction = normalize(mat3(InverseView) * (eye.xyz / eye.w));
    vec3 camera = RayCameraPosition.xyz;
    rayQueryEXT alpha;
    uint rejected = sulkanTraceTerrain(alpha, Atlas, camera, 0.002, direction, 128.0, false);
    rayQueryEXT forced;
    rayQueryInitializeEXT(forced, SulkanRayScene, gl_RayFlagsOpaqueEXT, 3, camera, 0.002, direction, 128.0);
    while (rayQueryProceedEXT(forced)) {}
    float first = -1.0, distance = -1.0, firstMaterial = -1.0;
    if (rayQueryGetIntersectionTypeEXT(forced, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        first = rayQueryGetIntersectionTEXT(forced, true);
        SulkanRaySurface hit = sulkanRayAttributes(rayQueryGetIntersectionInstanceCustomIndexEXT(forced, true),
            rayQueryGetIntersectionPrimitiveIndexEXT(forced, true), rayQueryGetIntersectionBarycentricsEXT(forced, true),
            sulkanRayAtlasShrink(textureSize(Atlas, 0)));
        firstMaterial = float(hit.material);
    }
    imageStore(Output1, pixel, vec4(0));
    if (rayQueryGetIntersectionTypeEXT(alpha, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        distance = rayQueryGetIntersectionTEXT(alpha, true);
        SulkanRaySurface hit = sulkanRayAttributes(rayQueryGetIntersectionInstanceCustomIndexEXT(alpha, true),
            rayQueryGetIntersectionPrimitiveIndexEXT(alpha, true), rayQueryGetIntersectionBarycentricsEXT(alpha, true),
            sulkanRayAtlasShrink(textureSize(Atlas, 0)));
        imageStore(Output1, pixel, vec4(hit.normal, rayQueryGetIntersectionFrontFaceEXT(alpha, true) ? 1 : 0));
    }
    imageStore(Output0, pixel, vec4(distance, first, firstMaterial, float(rejected)));
}
