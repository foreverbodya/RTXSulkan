#version 460
#include "shaders/atmosphere.glsl"
// Isotropic higher-order closure after Hillaire (2020), equations 5/7/9.
// Adapted to this RGB medium from Epic's MIT reference, commit 183ead5.
// See LICENSES/UnrealEngineSkyAtmosphere-MIT.txt and MULTIPLE_SCATTERING.md.
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(Output0);
    if(any(greaterThanEqual(pixel,size))) return;
    vec2 uv=vec2(pixel)/vec2(size-1);
    float height=0.001+59.999*uv.y*uv.y,muSun=uv.x*2.0-1.0;
    vec3 sun=vec3(sqrt(max(1.0-muSun*muSun,0.0)),muSun,0);
    vec3 radianceSum=vec3(0),feedbackSum=vec3(0);
    for(int i=0;i<64;i++) {
        float mu=1.0-2.0*(float(i%8)+0.5)/8.0,phi=2.0*ATM_PI*(float(i/8)+0.5)/8.0;
        vec3 direction=vec3(cos(phi)*sqrt(1.0-mu*mu),mu,sin(phi)*sqrt(1.0-mu*mu));
        float maximum=atmTopDistance(height,mu),ground=atmGroundDistance(height,mu);
        if(ground>=0.0) maximum=min(maximum,ground);
        vec3 transmittance=vec3(1),radiance=vec3(0),feedback=vec3(0);
        for(int j=0;j<32;j++) {
            float a=float(j)/32.0,b=float(j+1)/32.0;
            float begin=maximum*a*a,end=maximum*b*b,middle=(begin+end)*0.5;
            float altitude=atmHeightAlong(height,mu,middle);
            vec3 density=atmDensity(altitude),extinction=atmExtinction(density);
            vec3 scattering=ATM_RAYLEIGH*density.x+vec3(ATM_MIE_SCATTER*density.y);
            float localSun=((ATM_RADIUS+height)*sun.y+middle*dot(direction,sun))/(ATM_RADIUS+altitude);
            vec3 sunlight=atmSunTransmittance(altitude,clamp(localSun,-1.0,1.0),12);
            vec3 segment=exp(-extinction*(end-begin));
            vec3 integral=transmittance*(1.0-segment)/max(extinction,vec3(1e-9))*scattering;
            radiance+=integral*sunlight/(4.0*ATM_PI);
            feedback+=integral;
            transmittance*=segment;
        }
        if(ground>=0.0) {
            float localSun=((ATM_RADIUS+height)*sun.y+ground*dot(direction,sun))/ATM_RADIUS;
            radiance+=transmittance*(0.1/ATM_PI)*max(localSun,0.0)*atmSunTransmittance(0.001,clamp(localSun,-1.0,1.0),12);
        }
        radianceSum+=radiance;feedbackSum+=feedback;
    }
    // Unit solar irradiance here; the visible sky and lighting multiply ATM_SOLAR once.
    vec3 closure=(radianceSum/64.0)/max(vec3(1)-feedbackSum/64.0,vec3(1e-4));
    imageStore(Output0,pixel,vec4(closure,1));
}
