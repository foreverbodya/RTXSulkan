#version 460
#include "shaders/night-lighting.glsl"
void main() {
    ivec2 size=textureSize(Meter,0);float sum=0.0,weights=0.0,peak=0.0;
    for(int y=0;y<size.y;y++)for(int x=0;x<size.x;x++) {
        vec4 value=texelFetch(Meter,ivec2(x,y),0);sum+=value.x;weights+=value.y;peak=max(peak,value.w);
    }
    if(isnan(sum) || isinf(sum) || weights<=0.0) {
        imageStore(Output0,ivec2(0),vec4(uintBitsToFloat(0x7fc00000u)));return;
    }
    float meanLog=sum/weights,histogramWeight=0.0;
    for(int bin=0;bin<256;bin++)histogramWeight+=float(texelFetch(Histogram,ivec2(bin,0),0).r);
    float low=histogramWeight*0.50,high=histogramWeight*0.95,cumulative=0.0,selectedSum=0.0,selectedWeight=0.0;
    for(int bin=0;bin<256;bin++) {
        float count=float(texelFetch(Histogram,ivec2(bin,0),0).r);
        float selected=max(0.0,min(cumulative+count,high)-max(cumulative,low));
        selectedSum+=(-14.0+(float(bin)+0.5)*(30.0/256.0))*selected;
        selectedWeight+=selected;cumulative+=count;
    }
    if(selectedWeight<=0.0){imageStore(Output0,ivec2(0),vec4(uintBitsToFloat(0x7fc00000u)));return;}
    float maximumEV=cinematicExposureMaximum();
    float target=clamp(log2(cinematicExposureKey())-selectedSum/selectedWeight,-3.0,maximumEV);
    vec4 previous=texelFetch(Previous,ivec2(0),0);
    float dt=clamp(TimeDeltaFrame.x-previous.w,0.0,0.25);
    bool valid=CameraDeltaAndHistoryValid.w>0.5 && !any(isnan(previous)) && !any(isinf(previous))
        && previous.x>=-3.0 && previous.x<=maximumEV && previous.w>0.0 && previous.w<=TimeDeltaFrame.x;
    float rate=target>previous.x?1.0:2.0;
    float ev=valid?mix(previous.x,target,1.0-exp(-dt*rate)):target;
    // A cleared startup frame does not prime history to maximum exposure.
    bool unprimed=!valid && peak<=0.000001;
    if(unprimed)ev=0.0;
    // EV, current target EV, metered log2 luminance, frame timestamp.
    imageStore(Output0,ivec2(0),vec4(ev,target,meanLog,unprimed?0.0:TimeDeltaFrame.x));
}
