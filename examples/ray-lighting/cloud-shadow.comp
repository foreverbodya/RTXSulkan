#version 460
#include "shaders/atmosphere.glsl"
#include "shaders/cinematic-cloud-volume.glsl"
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(Output0);
    if(any(greaterThanEqual(p,size)))return;
    vec2 position=(vec2(p)+0.5)/vec2(size)*cinematicCloudPeriod(CloudLayout);
    vec3 light=cinematicKeyDirection();
    float optical=light.y>1e-6?cinematicCloudOpticalDepth(CloudLayout,
        vec3(position.x,cinematicCloudBottom(),position.y),light,16384.0,64):0.0;
#if SUNSET_CLOUD_SHADOW == 1
    // Art direction: a grazing 20x cloud column must not extinguish every
    // surface while the sky is still gold. Fade toward vertical optical depth
    // below 14 degrees, preserving the actual direction and terrain shadows.
    if(!cinematicMoonKey())optical*=mix(1.0,max(light.y,.04),1.0-smoothstep(.08,.25,light.y));
#endif
    float visibility=exp(-optical);
    imageStore(Output0,p,vec4(visibility));
}
