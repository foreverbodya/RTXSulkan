#version 460
#include "sulkan/ray-terrain.glsl"
#include "shaders/foliage.glsl"
#include "shaders/surface-lighting.glsl"
#ifdef CINEMATIC_ATMOSPHERE
#include "shaders/atmosphere.glsl"
#endif
#include "shaders/secondary-lighting.glsl"
#include "shaders/ggx-reflection.glsl"
#include "shaders/emission-sampling.glsl"
#ifndef ROUGH_SPECULAR
#define ROUGH_SPECULAR 0
#endif
vec3 roughEnvironment(vec3 direction) {
    float daylight=smoothstep(-0.05,0.15,SunDirectionAndRainBrightness.y);
    vec3 value=mix(vec3(.015,.02,.04),mix(vec3(.22,.28,.38),vec3(.12,.25,.5),clamp(direction.y,0.0,1.0)),daylight);
#ifdef CINEMATIC_ATMOSPHERE
    // Sky radiance excludes the solar disk, which already has explicit NEE.
    value=mix(value,atmSky(AtmosphereSky,direction),atmBlend());
#endif
    return value;
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(Output0);
    if(any(greaterThanEqual(pixel,size)))return;
    imageStore(Output0,pixel,vec4(0));imageStore(Output1,pixel,vec4(0));
#if ROUGH_SPECULAR == 1
    uvec2 surface=texelFetch(Surface,pixel,0).rg;
    float depth=texelFetch(Depth,pixel,0).r;uint bits=floatBitsToUint(depth);
    if(depth<=1e-7 || (surface.x&0xc0000000u)!=0x40000000u || max(bits,surface.y)-min(bits,surface.y)>2u)return;
    uint material=texelFetch(Material,pixel,0).y;
    if(material==1u || (material>=2u && material<=4u))return;
    vec4 geometry=texelFetch(NormalRoughness,pixel,0);
    float metal=texelFetch(EmissionMetal,pixel,0).a;
    // Smooth metals remain exclusively on the existing deterministic mirror path.
    if(metal>=.99 || geometry.w<=.025)return;
    vec2 uv=(vec2(pixel)+.5)/vec2(size);
    vec4 eye=InverseProjection*vec4(uv*2.0-1.0,depth,1);
    vec3 relative=mat3(InverseView)*(eye.xyz/eye.w);
    vec3 n=normalize(geometry.xyz),v=-sulkanCameraRay(uv).direction;
    float nv=dot(n,v),roughness=clamp(geometry.w,.08,1.0);
    if(nv<=0.0)return;
    vec3 origin=RayCameraPosition.xyz+relative+n*.005;
    vec3 f0=mix(vec3(.04),texelFetch(Albedo,pixel,0).rgb,metal),total=vec3(0);
    uint base=uint(pixel.x)+uint(pixel.y)*65537u;
    base^=indirectHash(RaySceneState.w+0x3f2a61c9u);
#if REALTIME_DIFFUSE == 1
    const uint paths=1u;
#else
    const uint paths=4u;
#endif
    for(uint i=0u;i<paths;i++) {
        uint seed=indirectHash(base^(i*0x9e3779b9u));
        vec3 lightDirection,lightRadiance;float lightPdf;
        if(cinematicSampleEmitter(origin,seed,lightDirection,lightRadiance,lightPdf)) {
            float specularPdf=roughReflectionPdf(roughness,n,v,lightDirection);
            vec3 halfVector=normalize(v+lightDirection);
            float mis=cinematicPowerWeight(lightPdf,specularPdf);
#if REALTIME_EMITTER_TREE == 1
            mis=1.0;
#endif
            total+=lightRadiance*roughReflectionWeight(f0,roughness,nv,dot(n,lightDirection),dot(v,halfVector))
                *(specularPdf/lightPdf)*mis;
        }
        vec2 sampleValue=indirectSampleSeed(seed).xy;
        vec3 h=roughReflectionHalf(v,n,roughness*roughness,sampleValue);
        vec3 direction=normalize(2.0*dot(v,h)*h-v);
        float nl=dot(n,direction),distance=-2.0;
        vec3 incoming=vec3(0);
        if(nl>0.0) {
            distance=-1.0;incoming=roughEnvironment(direction);
            rayQueryEXT query;foliageTraceRadiance(query,Atlas,origin,.002,direction,128.0);
            if(rayQueryGetIntersectionTypeEXT(query,true)!=gl_RayQueryCommittedIntersectionNoneEXT) {
                distance=rayQueryGetIntersectionTEXT(query,true);
                SulkanRaySurface hit=sulkanRayAttributes(rayQueryGetIntersectionInstanceCustomIndexEXT(query,true),
                    rayQueryGetIntersectionPrimitiveIndexEXT(query,true),rayQueryGetIntersectionBarycentricsEXT(query,true),
                    sulkanRayAtlasShrink(textureSize(Atlas,0)));
                incoming=secondaryAirHitSampled(hit,origin+direction*distance,direction,Atlas,seed);
                incoming=cinematicEmissionWeightedHit(incoming,hit,
                    rayQueryGetIntersectionInstanceCustomIndexEXT(query,true),rayQueryGetIntersectionPrimitiveIndexEXT(query,true),
                    distance,direction,roughReflectionPdf(roughness,n,v,direction));
#ifdef CINEMATIC_ATMOSPHERE
                incoming=mix(incoming,atmAerialWithLighting(incoming,direction,distance,AtmosphereLighting),atmBlend());
#endif
            }
        }
        total+=incoming*roughReflectionWeight(f0,roughness,nv,nl,dot(v,h));
        if(i==0u)imageStore(Output1,pixel,vec4(origin+direction*max(distance,0.0),distance));
    }
#if REALTIME_DIFFUSE == 1
    vec3 result=total;
#else
    vec3 result=total*.25;
#endif
#ifdef CINEMATIC_ATMOSPHERE
    // Direct pass already adds camera-path in-scatter; apply only extinction.
    result*=mix(vec3(1),atmAirTransmittance(length(relative)),atmBlend());
#endif
    imageStore(Output0,pixel,vec4(result,1));
#endif
}
