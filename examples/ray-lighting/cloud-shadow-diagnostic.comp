#version 460
#include "shaders/atmosphere.glsl"
#include "shaders/cloud-shadow.glsl"
void main() {
    ivec2 id=ivec2(gl_GlobalInvocationID.xy),size=imageSize(Output0);
    if(any(greaterThanEqual(id,size)))return;
    vec2 period=cinematicCloudPeriod(CloudLayout);
    int mode=id.x%3;
    float height=mode==0?cinematicCloudBottom()-float(id.y+1)*8.0:
        mode==1?cinematicCloudBottom()+(float(id.y)+0.5)/float(size.y)*CLOUD_THICKNESS:
        cinematicCloudBottom()+CLOUD_THICKNESS+1.0;
    vec3 p=vec3((float(id.x)+0.37)/float(size.x)*period.x*(id.x%2==0?1.0:-1.0),
        height,-(float(id.y)+0.23)/float(size.y)*period.y);
    vec3 cloudOrigin=cinematicCloudOrigin(CloudLayout);
    precise vec3 rayPosition=RayCameraPosition.xyz+(p-cloudOrigin);
    precise vec3 effective=cloudOrigin+(rayPosition-RayCameraPosition.xyz);
    precise vec3 shiftedX=effective+vec3(period.x,0,0),shiftedZ=effective-vec3(0,0,period.y);
    vec3 light=cinematicKeyDirection();
    imageStore(Output0,id,vec4(cinematicCloudRaySolarVisibility(CloudLayout,CloudShadow,rayPosition,light),
        cinematicCloudWorldSolarVisibility(CloudLayout,CloudShadow,shiftedX,light),
        cinematicCloudWorldSolarVisibility(CloudLayout,CloudShadow,shiftedZ,light),
        cinematicCloudWorldSolarVisibility(CloudLayout,CloudShadow,effective,light)));
    imageStore(Output1,id,vec4(effective,float(mode)));
}
