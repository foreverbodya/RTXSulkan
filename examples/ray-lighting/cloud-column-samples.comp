#version 460
#include "shaders/cloud-view-density.glsl"
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(Output0);
    if(any(greaterThanEqual(p,size)))return;
    ivec2 column=ivec2(p.y%32,p.y/32);
    vec3 origin=texelFetch(Positions,column*4,0).xyz;
    const vec3 directions[8]=vec3[8](vec3(1,0,0),vec3(-1,0,0),vec3(0,1,0),vec3(0,-1,0),
        vec3(0,0,1),vec3(0,0,-1),vec3(1,1,1),vec3(-1,1,-1));
    const float lengths[8]=float[8](0.0,0.001,0.125,0.5,1.0,2.0,6.0,31.25);
    float length=lengths[column.x%8];vec3 direction=normalize(directions[column.y%8]);
    int count=clamp(int(ceil(length)),1,32);float ds=length/float(count);
    imageStore(Output0,p,p.x<count?cinematicCloudDensitySample(CloudLayout,origin,direction,(float(p.x)+0.5)*ds):vec4(0));
}
