{
	"schemaVersion": 1,
	"id": "sulkan",
	"version": "${version}",
	"name": "Sulkan",
	"description": "Native shader support for Minecraft's Vulkan renderer, powered by Sodium.",
	"authors": [
		"mravatin"
	],
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.sulkan.shaders.SulkanShadersClient"
		]
	},
	"mixins": [
		{
			"config": "sulkan-shaders.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.4",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.160.5",
		"sodium": ">=0.9.2"
	}
}

