{
	"schemaVersion": 1,
	"id": "sulkan",
	"version": "${version}",
	"name": "Sulkan",
	"description": "Vulkan backend optimizations and optional shader loading for Minecraft.",
	"authors": [
		"mravatin"
	],
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.sulkan.core.SulkanCoreClient",
			"com.sulkan.shaders.SulkanShadersClient"
		]
	},
	"mixins": [
		{
			"config": "sulkan.mixins.json",
			"environment": "client"
		},
		{
			"config": "sulkan-shaders.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-lifecycle-events-v1": "*"
	}
}
